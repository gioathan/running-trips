# Copy to .env (same directory as docker-compose.prod.yml) on the VM.
# Read automatically by `docker compose` for the ${VAR} substitutions in
# docker-compose.prod.yml — separate from backend/.env, which holds the
# FastAPI app's own settings (see backend/.env.example).

POSTGRES_USER=runtrips
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=runtrips

# Public DNS name for the API, e.g. api.yourdomain.com — must already point
# (A record) at this VM's IP before starting Caddy, so it can issue a
# Let's Encrypt certificate for it.
API_DOMAIN=api.example.com
