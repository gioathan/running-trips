# --- App ---
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-random-64-char-value
FRONTEND_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://runtrips:runtrips@postgres:5432/runtrips

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS_REMEMBER_ME=90
ADMIN_ACCESS_TOKEN_TTL_MINUTES=15
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="ΑΛΛΟΥ <no-reply@example.com>"

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=running-trips
R2_PUBLIC_BASE_URL=https://media.example.com
