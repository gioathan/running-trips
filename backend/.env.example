# --- App ---
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-random-64-char-value
FRONTEND_ORIGIN=http://localhost:3000
# Same value as BACKEND_PROXY_SECRET in the frontend's env — lets the backend
# trust the end-user IP the Next.js server forwards (per-IP rate limits).
# Required outside local dev: the API refuses to start without it.
PROXY_SHARED_SECRET=
# Requests per minute allowed from one visitor across the whole API. Leave
# unset for the default (300; off in local dev). 0 disables it.
# GLOBAL_RATE_LIMIT_PER_MINUTE=300
# Same value as REVALIDATE_SECRET in the frontend's env — admin content saves
# then refresh the public site immediately instead of after the ISR window.
REVALIDATE_SECRET=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://runtrips:runtrips@postgres:5432/runtrips

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS_REMEMBER_ME=90
ADMIN_ACCESS_TOKEN_TTL_MINUTES=15
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
# Audience newsletter subscribers are synced into — create one in Resend's dashboard.
RESEND_AUDIENCE_ID=
EMAIL_FROM="ΑΛΛΟΥ <no-reply@example.com>"

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=running-trips
R2_PUBLIC_BASE_URL=https://media.example.com
