# Server-side only — the FastAPI backend's base URL. Used by Server
# Components (direct fetch, cacheable) and by the /api/backend/* proxy
# route (client-originated authenticated calls). Never exposed to the browser.
BACKEND_URL=http://api:8000

# Server-side only — same value as the backend's PROXY_SHARED_SECRET. Sent with
# every proxied call alongside the browser's IP, so backend rate limits key on
# the real user rather than this server's IP.
BACKEND_PROXY_SECRET=

# Shared secret the backend calls back with to trigger on-demand ISR
# revalidation from an admin content save (BACKEND_PLAN.md §10 / FRONTEND_PLAN.md §9).
REVALIDATE_SECRET=change-me

# Public — safe to expose to the browser.
# The public site's origin (no trailing slash) — used for canonical/hreflang
# URLs, Open Graph images, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The only outside host the image optimizer may load images from: your R2
# custom domain, or the bucket's own pub-….r2.dev host.
NEXT_PUBLIC_MEDIA_HOSTNAME=media.example.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
